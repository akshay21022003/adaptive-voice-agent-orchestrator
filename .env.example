# Copy this file to .env and fill in real values.

OPENAI_API_KEY=sk-your-key-here

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mini-agent

# App / SQLAlchemy connection string (single source of truth)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/mini-agent

# pgAdmin web UI (http://localhost:5050)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Optional: chat model (default gpt-4o-mini) and TLS verification for OpenAI calls.
# Set OPENAI_SSL_VERIFY=false only for local dev behind an intercepting proxy.
OPENAI_MODEL
OPENAI_SSL_VERIFY

# Optional tuning (defaults shown)
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=4
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# CHECKPOINT_POOL_SIZE=10
# THREAD_LIMIT=100

# Browser origins allowed to call the API (comma separated, no wildcard).
# Add your deployed frontend URL here. Default: http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
